name: Salvar Novo Cliente no Banco

on:
  repository_dispatch:
    types: [novo_cadastro]

jobs:
  atualizar_banco:
    runs-on: ubuntu-latest
    steps:
      - name: Baixar código do repositório
        uses: actions/checkout@v4

      - name: Adicionar dados no arquivo JSON
        run: |
          PAYLOAD='${{ toJson(github.event.client_payload) }}'
          if [ ! -f banco_dados/clientes.json ]; then
            mkdir -p banco_dados
            echo "[]" > banco_dados/clientes.json
          fi
          python3 -c "
import json, os
with open('banco_dados/clientes.json', 'r') as f:
    dados = json.load(f)
novo = json.loads('''$PAYLOAD''')
dados.append(novo)
with open('banco_dados/clientes.json', 'w') as f:
    json.dump(dados, f, indent=2)
"

      - name: Gravar alterações no banco do GitHub
        run: |
          git config --global user.name "GitHub Action"
          git config --global user.email "action@github.com"
          git add banco_dados/clientes.json
          git commit -m "Banco updated: Novo cliente cadastrado"
          git push
        env:
          GITHUB_TOKEN: ${{ secrets.TOKEN_GITHUB }}
